{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "example-sast",
          "rules": []
        }
      },
      "results": [
        {
          "ruleId": "EXAMPLE-LOG4J",
          "level": "error",
          "message": {
            "text": "Apache Log4j2 JNDI features do not protect against attacker controlled LDAP endpoints"
          },
          "properties": {
            "tags": ["security", "CVE-2021-44228", "GHSA-jfh8-c2jp-5v3q"],
            "security-severity": "9.8",
            "package": {
              "ecosystem": "npm",
              "name": "log4j-js",
              "version": "2.0.0"
            },
            "references": ["https://nvd.nist.gov/vuln/detail/CVE-2021-44228"]
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/package-lock.json"
                },
                "region": {
                  "startLine": 12
                }
              }
            }
          ]
        },
        {
          "ruleId": "EXAMPLE-PROTOTYPE",
          "level": "warning",
          "message": {
            "text": "Prototype pollution through an unvalidated configuration merge"
          },
          "properties": {
            "tags": ["security", "CVE-2020-11111"],
            "security-severity": "7.5",
            "package": {
              "ecosystem": "npm",
              "name": "config-merge",
              "version": "1.4.2"
            },
            "references": ["https://nvd.nist.gov/vuln/detail/CVE-2020-11111"]
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/src/config.js"
                },
                "region": {
                  "startLine": 48
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
